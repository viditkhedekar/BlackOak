# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
# Host port 5434 — the docker-compose Postgres (5432/5433 are taken on some machines)
DATABASE_URL=postgresql+asyncpg://blackoak:blackoak@localhost:5434/blackoak
CORS_ORIGINS=["http://localhost:3000"]

# Alpaca PAPER keys only — https://app.alpaca.markets (paper dashboard)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
